# Ozma node — desktop profile
# Prefer a systemd --user unit for this profile so the node can reach the
# logged-in session's PipeWire server and XDG_RUNTIME_DIR. A system unit runs
# as ozma-node and cannot see another user's session by default.
#
# System install: /etc/ozma/ozma-node-desktop.env
# User install:   ~/.config/ozma/ozma-node-desktop.env
# EnvironmentFile syntax: KEY=VALUE, no shell expansion.

# PipeWire capture target: default, name:<node.name>, object:<name>, node:<id>.
OZMA_DESKTOP_CAPTURE_TARGET=default
OZMA_DESKTOP_CAPTURE_WIDTH=1920
OZMA_DESKTOP_CAPTURE_HEIGHT=1080
OZMA_DESKTOP_CAPTURE_FPS=30
OZMA_AUDIO_CAPTURE_TARGET=default
# Required for /audio/* control routes; it controls an existing server.
# OZMA_AUDIO_ROUTER=pipewire

# X11 fallback instead of PipeWire capture (explicit display, never ambient):
# OZMA_X11_DISPLAY=:0
# OZMA_X11_WIDTH=1920
# OZMA_X11_HEIGHT=1080
# OZMA_NODE_ARGS="--capture-provider x11 --x11-display :0"

OZMA_HLS_DIR=/var/lib/ozma-node/hls/desktop
# OZMA_NODE_ARGS=--hls --hls-fps 15
RUST_LOG=ozma_node=info
