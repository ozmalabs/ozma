# Ozma virtual-node supervisor
# Install as /etc/ozma/ozma-virtual-node.env.
# EnvironmentFile syntax: KEY=VALUE, no shell expansion; values are not
# shell-quoted. Keep this file mode 0600 when it contains a token.

# Optional extra flags (--qmp-dir has no environment variable of its own). Keep --provision/--provision-restart out of the
# default unit: editing libvirt XML and rebooting VMs is an explicit operator
# action, not a boot-time default.
OZMA_VIRTUAL_NODE_ARGS=--qmp-dir /run/ozma/qmp

# Child API polling is off by default. Enable both to aggregate child state.
# OZMA_VIRTUAL_NODE_ARGS=--qmp-dir /run/ozma/qmp --child-poll-interval-ms 5000
# OZMA_NODE_API_TOKEN=replace-with-a-secret

RUST_LOG=ozma_virtual_node=info,ozma_node=info
