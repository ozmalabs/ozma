# Ozma node — vm profile (single VM)
# Install as /etc/ozma/ozma-node-vm.env for ozma-node@vm.service, or copy to
# /etc/ozma/vm-<name>.env for ozma-node-vm@<name>.service (which adds
# --name <name>). EnvironmentFile syntax: KEY=VALUE, no shell expansion.
#
# This unit does not start QEMU. Point it at sockets created by libvirt/QEMU
# (or by `ozma-virtual-node --provision`).

OZMA_QMP_SOCKET=/run/ozma/qmp/vm1.qmp
# A separately provisioned input socket avoids sharing the control client.
# OZMA_QMP_INPUT_SOCKET=/run/ozma/qmp/vm1-input.qmp
# D-Bus display alternative: --capture-provider dbus and OZMA_DBUS_CONSOLE=0
# in OZMA_NODE_ARGS. VNC alternative: OZMA_VNC_HOST=127.0.0.1 and
# OZMA_VNC_PORT=5901 (requires ffmpeg with the VNC demuxer).

# Per-VM audio sink created by `ozma-virtual-node --provision-audio` or pactl.
OZMA_AUDIO_SINK=ozma-vm1
OZMA_AUDIO_CAPTURE_TARGET=monitor:ozma-vm1
OZMA_AUDIO_ROUTER=pipewire

OZMA_HLS_DIR=/var/lib/ozma-node/hls/vm1
# --hls is not controlled by an environment variable; add it here.
OZMA_NODE_ARGS=--capture-provider qmp --input-provider qmp --power-provider qmp --hls --hls-fps 30

# Optional WebRTC helper (Python 3 + GStreamer). scripts/install-rust.sh
# installs the helper under <prefix>/share/ozma/webrtc/ (for example
# ~/.local/share/ozma/webrtc/ or /usr/local/share/ozma/webrtc/).
# OZMA_WEBRTC_HELPER=python3
# OZMA_WEBRTC_HELPER_SCRIPT=/usr/local/share/ozma/webrtc/gst_webrtc_worker.py

# OZMA_API_TOKEN=replace-with-a-secret   # keep the file mode 0600
RUST_LOG=ozma_node=info,ozma_qmp=info
