[Unit]
Description=Ozma VM node %i
Documentation=https://github.com/ozmalabs/ozma/blob/main/docs/clean-host.md
After=network-online.target libvirtd.service
Wants=network-online.target
# Use this template when one unit per VM is preferred. The alternative is
# ozma-virtual-node, which discovers VMs and spawns one ozma-node per VM.
[Service]
Type=simple
ExecStart=@BIN_DIR@/ozma-node --profile vm --name %i $OZMA_NODE_ARGS
EnvironmentFile=-@ENV_DIR@/vm-%i.env

User=@OZMA_USER@
Group=@OZMA_GROUP@
SupplementaryGroups=kvm input render

Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0027

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
# QMP input needs either /dev/uinput or the QMP socket; both are allowed here.
DeviceAllow=/dev/uinput rw
DeviceAllow=/dev/input/event* rw
DeviceAllow=/dev/dri/renderD* rw
ReadWritePaths=@STATE_DIR@ @RUNTIME_DIR@
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
