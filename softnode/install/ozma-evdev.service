# LEGACY (one-release Python rollback path).
# The Rust path creates the same virtual keyboard/pointer devices with
#   ozma-softnode --provision --provision-evdev
# (or `ozma-node --profile vm --input-provider ...`), so this Python service is
# no longer the default. It stays for the overlap release only.
[Unit]
Description=Ozma virtual evdev devices for VM input-linux (legacy Python)
Before=libvirtd.service
After=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/ozma/softnode/evdev_service.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
